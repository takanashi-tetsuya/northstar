* text=auto

*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.sql text eol=lf
# Published migration bytes are checksum authority. Do not normalize an
# existing file merely to remove its historical blank line at EOF.
migrations/*.sql whitespace=-blank-at-eof
Dockerfile text eol=lf
Makefile text eol=lf
*.bat text eol=crlf

*.wasm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
