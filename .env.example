# ==============================================================================
# Northstar XMPP Server Configuration
# ==============================================================================

# Hermetic service/test launchers can set NORTHSTAR_DISABLE_DOTENV=true to
# ignore this file and use only their explicitly supplied process environment.

# OCI image metadata. Set NORTHSTAR_VCS_REF to the exact release commit before
# building production images; leaving it as "unknown" is suitable only for
# local development builds.
NORTHSTAR_VERSION=0.2.0
NORTHSTAR_VCS_REF=unknown
# The release Compose override consumes these complete references. Tags are
# convenient for initial selection; production can replace each value with the
# corresponding name@sha256:digest reference printed by the release workflow.
NORTHSTAR_SERVER_IMAGE_REF=ghcr.io/takanashi-tetsuya/northstar:0.2.0
NORTHSTAR_DATABASE_GRANTS_IMAGE_REF=ghcr.io/takanashi-tetsuya/northstar-database-grants:0.2.0
NORTHSTAR_BACKUP_IMAGE_REF=ghcr.io/takanashi-tetsuya/northstar-backup:0.2.0

# ------------------------------------------------------------------------------
# Core Server Settings
# ------------------------------------------------------------------------------
XMPP_DOMAIN=localhost
SERVER_NAME=Northstar
PUBLIC_URL=http://localhost:8080
# Browser WebSocket origins must match PUBLIC_URL. Add only trusted hosted web
# clients that genuinely need cross-origin access (comma-separated exact
# origins, no paths). Plain HTTP entries are accepted only for loopback.
WEBSOCKET_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# Network & Bind Addresses
# ------------------------------------------------------------------------------
XMPP_BIND=0.0.0.0:5222
XMPPS_BIND=0.0.0.0:5223
# Native/default deployment keeps REST, WebSocket, static UI and readiness on
# loopback. Docker Compose explicitly binds 0.0.0.0 only inside its isolated
# frontend network and publishes host port 8080 on 127.0.0.1.
HTTP_BIND=127.0.0.1:8080
# Prometheus is deliberately served by a separate listener. Loopback needs no
# token; any non-loopback bind fails startup unless a bearer-token file exists.
METRICS_BIND=127.0.0.1:9091
# METRICS_BEARER_TOKEN_FILE=/run/secrets/metrics_bearer_token
# METRICS_BEARER_TOKEN_HOST_FILE=/etc/northstar/secrets/metrics_bearer_token
# PROMETHEUS_METRICS_BEARER_TOKEN_HOST_FILE=/etc/northstar/secrets/prometheus_metrics_bearer_token
# XEP-0124/XEP-0206 is opt-in and is usable only through a trusted HTTPS
# reverse proxy. Northstar never treats direct plaintext HTTP as an encrypted
# XMPP transport. `/http-bind` is canonical and `/bosh` is an alias.
BOSH_ENABLED=false
BOSH_MAX_SESSIONS=2048
# Caps simultaneous request-body buffering before SID validation. Long-polling
# waits do not retain this permit or their original HTTP body.
BOSH_MAX_CONCURRENT_BODY_READS=128
# Bounds slow request uploads so the global body-read slots cannot be pinned.
BOSH_BODY_READ_TIMEOUT_SECONDS=15
BOSH_MAX_WAIT_SECONDS=60
BOSH_INACTIVITY_SECONDS=30
BOSH_POLLING_SECONDS=5
BOSH_MAX_PAUSE_SECONDS=120
BOSH_MAX_REQUEST_BYTES=1048576
BOSH_MAX_RESPONSE_BYTES=1048576
BOSH_MAX_STANZAS_PER_REQUEST=64
BOSH_MAX_OUTPUT_STANZAS=128
BOSH_MAX_OUTPUT_BYTES=4194304
S2S_BIND=0.0.0.0:5269
S2S_TLS_BIND=0.0.0.0:5270
MAX_S2S_CONNECTIONS=512
# External components are disabled by default. The legacy XEP-0114 transport
# is plaintext, so its safe default bind is loopback. See
# deploy/components.example.json and deploy/docker-compose.components.yml
# before enabling either component profile. Each JSON entry must set exactly
# one of `secret` (zeroized in memory) or `secret_file` (preferred for
# production; non-symlink, owner-only mode 0400/0600).
COMPONENT_BIND=127.0.0.1:5347
COMPONENTS_ENABLED=false
# The component JSON file itself is also required to be a non-symlink,
# owner-only 0400/0600 file because it may contain an inline secret.
# COMPONENTS_CONFIG_FILE=deploy/components.json
# Set to 0 only when external components are disabled; no accept listener or
# connect-mode supervisor is started and registry admission fails closed.
MAX_COMPONENT_CONNECTIONS=128
COMPONENT_HANDSHAKE_TIMEOUT_SECONDS=15
COMPONENT_QUEUE_CAPACITY=512
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Compose pins Caddy to a private frontend address so forwarded client IPs are
# trusted only from that exact container. Change the subnet/IPs together if the
# default range conflicts with the host network.
FRONTEND_SUBNET=172.31.240.0/24
CADDY_PROXY_IP=172.31.240.2
XMPP_HTTP_IP=172.31.240.3

# XEP-0487 host-meta v2 is experimental and is asserted only when this list
# contains the literal public IPv4/IPv6 addresses on which every advertised
# transport below is actually reachable. Leave empty to retain XEP-0156
# WebSocket discovery without suppressing legacy DNS/SRV discovery.
XEP_0487_IPS=
XEP_0487_TTL_SECONDS=300
XEP_0487_PRIORITY=10
XEP_0487_WEIGHT=50

# ------------------------------------------------------------------------------
# TLS / SSL Configuration
# ------------------------------------------------------------------------------
TLS_CERT_PATH=certs/server.crt
TLS_KEY_PATH=certs/server.key
# Public XMPP domains are accepted only when the leaf is currently valid for
# XMPP_DOMAIN and serverAuth, uses a supported strong RSA/ECDSA key, and builds
# to the WebPKI roots (plus FEDERATION_EXTRA_ROOT_CERT_PATH when configured).
# Self-signed certificates are limited to reserved development names such as
# localhost and *.test. Linux production keys must be regular, non-symlink
# files with exact mode 0400 or 0600.
# Docker Compose host paths may point outside the project. The container mounts
# only these two files instead of exposing the whole certs directory.
TLS_CERT_HOST_PATH=certs/server.crt
TLS_KEY_HOST_PATH=certs/server.key

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL)
# ------------------------------------------------------------------------------
# Native server execution reads DATABASE_URL. DATABASE_URL_FILE is an
# alternative for secret managers that mount the runtime URL; never set both.
# Schema changes are explicit: run `xmpp-server migrate` with
# MIGRATOR_DATABASE_URL(_FILE) before starting the server.  The Compose stack
# wires this one-shot boundary automatically.
DATABASE_URL=postgres://northstar_runtime:replace-with-a-strong-password@localhost/northstar
# DATABASE_URL_FILE=/run/secrets/database_url
# XEP-0133 session lifecycle uses a separate login with no table privileges.
# Production must mount this URL; explicit loopback development may omit it
# and reuse DATABASE_URL under DATABASE_ALLOW_UNSAFE_ROLE_FOR_DEVELOPMENT.
# ADMIN_COMMAND_DATABASE_URL=postgres://northstar_commands:replace-with-an-independent-password@localhost/northstar
# ADMIN_COMMAND_DATABASE_URL_FILE=/run/secrets/command_database_url
# For a source-based local development install, this may temporarily be the
# same owner URL as DATABASE_URL. Production Compose ignores this value and
# mounts its dedicated migrator URL only into the one-shot migration job.
# MIGRATOR_DATABASE_URL=postgres://northstar_migrator:replace-with-a-strong-password@localhost/northstar
# MIGRATOR_DATABASE_URL_FILE=/run/secrets/migrator_database_url
# Compose reads secrets from a root-owned directory outside the checkout.
# First create `/etc/northstar` as root:root mode 0700, then generate with
# `sudo sh scripts/create-production-secrets.sh`. Secret values never belong in
# .env or under the Git working tree. Override only with a secret directory
# whose pre-created parent is an absolute root:root mode-0700 directory.
NORTHSTAR_SECRET_DIR=/etc/northstar/secrets
# Individual path overrides are normally unnecessary; Compose derives all of
# these from NORTHSTAR_SECRET_DIR. Uncomment only when deliberately separating
# one capability into another protected root-owned directory.
# POSTGRES_BOOTSTRAP_PASSWORD_SECRET_FILE=/etc/northstar/secrets/postgres_bootstrap_password
# NORTHSTAR_MIGRATOR_PASSWORD_SECRET_FILE=/etc/northstar/secrets/northstar_migrator_password
# NORTHSTAR_RUNTIME_PASSWORD_SECRET_FILE=/etc/northstar/secrets/northstar_runtime_password
# NORTHSTAR_COMMAND_PASSWORD_SECRET_FILE=/etc/northstar/secrets/northstar_command_password
# NORTHSTAR_BACKUP_PASSWORD_SECRET_FILE=/etc/northstar/secrets/northstar_backup_password
# MIGRATOR_DATABASE_URL_SECRET_FILE=/etc/northstar/secrets/migrator_database_url
# RUNTIME_DATABASE_URL_SECRET_FILE=/etc/northstar/secrets/runtime_database_url
# COMMAND_DATABASE_URL_SECRET_FILE=/etc/northstar/secrets/command_database_url
# BACKUP_DATABASE_URL_SECRET_FILE=/etc/northstar/secrets/backup_database_url
# BACKUP_SIGNING_KEY_SECRET_FILE=/etc/northstar/secrets/backup_signing_ed25519.pem
# BACKUP_VERIFY_KEY_SECRET_FILE=/etc/northstar/secrets/backup_signing_ed25519.pub.pem
# BACKUP_AGE_RECIPIENTS_SECRET_FILE=/etc/northstar/secrets/backup_age_recipients.txt
# BACKUP_AGE_IDENTITY_SECRET_FILE=/etc/northstar/secrets/backup_age_identity.txt
BACKUP_PLAINTEXT_SCRATCH_SIZE=4g
RESTORE_PLAINTEXT_SCRATCH_SIZE=4g
DATABASE_MAX_CONNECTIONS=32
DATABASE_MIN_CONNECTIONS=2
# Local source builds which intentionally reuse an owner URL must opt in. This
# is rejected for non-loopback listeners, non-loopback Redis, or a non-reserved
# domain and must remain false/absent in production.
DATABASE_ALLOW_UNSAFE_ROLE_FOR_DEVELOPMENT=false
# One-shot migration equivalent for isolated localhost/.localhost/.test
# fixtures. The PostgreSQL server must also be loopback (or a local Unix
# socket). Never enable this for a production migration.
MIGRATOR_ALLOW_UNSAFE_ROLE_FOR_DEVELOPMENT=false
# Optional and experimental: enable only when testing multi-node routing.
# Optional experimental multi-node control plane. Prefer REDIS_URL_FILE so
# credentials do not appear in the process environment. Plain redis:// is
# accepted only for an explicit loopback host; remote deployments require
# rediss:// with hostname verification. The CA path is optional for a public
# CA. Configure both client files when Redis requires mTLS.
# REDIS_URL_FILE=/run/secrets/redis_url
# REDIS_TLS_CA_CERT_PATH=/run/secrets/redis_ca.pem
# REDIS_TLS_CLIENT_CERT_PATH=/run/secrets/redis_client.pem
# REDIS_TLS_CLIENT_KEY_PATH=/run/secrets/redis_client.key
# Redis cluster mode also requires application-layer node authentication. A
# single-node deployment without REDIS_URL needs none of these values. Node IDs
# are stable operator-assigned identities; never reuse one for two live
# processes. The private key is file-only and contains unpadded base64url
# Ed25519 PKCS#8 DER. Peer files contain public keys plus explicit command ACLs.
# See docs/CLUSTERING.md and deploy/cluster-peers.example.json.
# CLUSTER_NODE_ID=node-a
# CLUSTER_SIGNING_PRIVATE_KEY_FILE=/run/secrets/cluster_node_a.pkcs8.b64
# CLUSTER_PEER_KEYS_FILE=/etc/northstar/cluster-peers.json
# CLUSTER_SIGNING_KEY_EPOCH=1
# CLUSTER_FAILURE_POLICY=fail_closed
# CLUSTER_SAFETY_LEASE_SECONDS=120
# Rotation prepare phase only: public raw Ed25519 key for epoch+1.
# CLUSTER_SIGNING_STAGED_NEXT_PUBLIC_KEY_FILE=/run/secrets/cluster_node_a.next.pub
# Rotation activate/overlap phase only: public raw key for epoch-1.
# CLUSTER_SIGNING_PREVIOUS_PUBLIC_KEY_FILE=/run/secrets/cluster_node_a.previous.pub
# PBKDF2-HMAC-SHA-256 work factor stored in new SCRAM verifiers. Existing
# verifiers keep their own count; a successful password-based login upgrades a
# weaker verifier. RFC 7677 requires at least 4096; 600000 follows current OWASP
# guidance and should be benchmarked on the intended clients before deployment.
SCRAM_ITERATIONS=600000
# Disabled by default. Enable only for legacy clients which cannot use
# SCRAM-SHA-256; SHA-256 remains preferred and is advertised first. Accounts
# created before the SHA-1 verifier migration acquire an independent verifier
# only after a successful password login or password reset. Do not enable this
# switch until every required legacy account has completed that backfill.
SCRAM_SHA1_ENABLED=false
# Optional, independent CA bundle for C2S SASL EXTERNAL. When absent the
# server does not request client certificates and does not advertise EXTERNAL.
# Client leaves must pass PKIX clientAuth validation and carry a bare local JID
# in an id-on-xmppAddr SAN otherName (OID 1.3.6.1.5.5.7.8.5); CN and DNS SAN
# fallback are intentionally forbidden.
# C2S_CLIENT_TRUST_ROOT_CERT_PATH=certs/trust/client-ca.crt
# Optional local PEM CRL bundle. When set, every non-root certificate in the
# clientAuth path needs known, unexpired revocation status.
# C2S_CLIENT_CRL_PATH=certs/trust/client.crl.pem

# ------------------------------------------------------------------------------
# Registration & User Management
# ------------------------------------------------------------------------------
OPEN_REGISTRATION=true
# true: every REST and XEP-0077 registration must consume a valid invitation.
# false: invitations stay optional; PoW and rate limits still apply.
INVITATION_REQUIRED=false
REGISTRATION_RATE_PER_HOUR=20

# ------------------------------------------------------------------------------
# Session & Message Settings
# ------------------------------------------------------------------------------
SESSION_TTL_HOURS=168
SM_RESUME_TIMEOUT_SECONDS=300
# Durable XEP-0198 recovery. `subnet` binds IPv4 /24 and IPv6 /64; use
# `exact` for high-security fixed-address deployments or `none` only when a
# deployment deliberately accepts bearer-token-only recovery.
SM_LIVE_LEASE_SECONDS=120
SM_CLAIM_LEASE_SECONDS=30
SM_MAX_UNACKED_STANZAS=512
SM_MAX_UNACKED_BYTES=4194304
# Complete snapshot and process-local recovery authority. Live streams reserve
# their actual retained bytes (so 1000 empty/low-traffic SM sessions fit); a
# resume claim temporarily reserves one maximum snapshot before its DB read.
SM_MAX_SNAPSHOT_BYTES=4194304
SM_MEMORY_BUDGET_BYTES=1073741824
SM_RECOVERY_MAX_BYTES=268435456
SM_RECOVERY_MAX_JOBS=1024
SM_MAX_RESUMABLE_SESSIONS=4096
SM_IP_BINDING=subnet
# Strict mode requires the XEP-0388 user-agent UUID supplied by SASL2. Legacy
# SASL clients still receive SM acknowledgements but negotiate resume=false.
SM_REQUIRE_SAME_DEVICE=true
OFFLINE_MESSAGE_TTL_DAYS=30
# Personal and room MAM are capped at one year by default. For any of these
# three retention-day settings, 0 disables automated deletion; it never means
# "purge immediately". Existing XEP-0441 MAM preferences still decide whether
# a message is archived in the first place.
MAM_RETENTION_DAYS=365
MUC_MAM_RETENTION_DAYS=365
# Resolved moderation cases and copied evidence; 0 is an explicit legal hold.
MODERATION_RETENTION_DAYS=365
# Insert-only administrative audit metadata is bounded separately. This must
# remain finite (30..36500); export and anchor the chain root before expiry if
# your policy requires longer independent evidence.
AUDIT_LOG_RETENTION_DAYS=730
RETENTION_CLEANUP_BATCH_SIZE=1000
RETENTION_CLEANUP_INTERVAL_SECONDS=60
OFFLINE_MAX_MESSAGES_PER_ACCOUNT=1000
OFFLINE_MAX_BYTES_PER_ACCOUNT=104857600
REQUIRE_ENCRYPTED_ARCHIVE=true

# Resource ceilings for a single-node deployment. The 1000-session validation
# script raises its per-account/per-IP limits explicitly for that artificial
# one-account load shape.
MAX_CLIENT_CONNECTIONS=4096
MAX_CONNECTIONS_PER_IP=512
MAX_SESSIONS_PER_ACCOUNT=64
# PostgreSQL-authoritative deployment-wide ceilings. Every node must use the
# same values for one epoch. Increment DEPLOYMENT_CAPACITY_EPOCH when changing
# any value; an older/different configuration fails startup. The four global
# ledgers use 64 hard-budget shards. Admission starts from a stable UUID-byte
# shard and probes every shard at most once, so rejection means the complete
# deployment budget is occupied (without a runtime COUNT/SUM scan).
DEPLOYMENT_CAPACITY_EPOCH=1
MAX_ACCOUNTS_TOTAL=100000
MAX_MUC_ROOMS_TOTAL=10000
MAX_MUC_ROOMS_PER_OWNER=100
MAX_LIVE_SESSIONS_TOTAL=4096
# A committed bind owns a PostgreSQL lease, including while an XEP-0198 stream
# is resumable. Three missed heartbeats expire it; maintenance then releases
# the exact shard allocation. Keep LEASE >= 3 * HEARTBEAT.
CAPACITY_SESSION_LEASE_SECONDS=120
CAPACITY_SESSION_HEARTBEAT_SECONDS=30
UNAUTHENTICATED_TIMEOUT_SECONDS=30
# Successful legacy SASL streams must bind a resource within this deadline.
# SASL2 Bind 2 and inline SM resume are already bound and are exempt.
RESOURCE_BIND_TIMEOUT_SECONDS=30
PUBSUB_MAX_NODES_PER_OWNER=100
PEP_MAX_NODES_PER_ACCOUNT=100
# Aggregate persisted XML payload limits per owner/account (100 MiB defaults).
PUBSUB_MAX_STORAGE_BYTES_PER_OWNER=104857600
PEP_MAX_STORAGE_BYTES_PER_ACCOUNT=104857600
# Deferred XEP-0408 partial mirror. Leave disabled unless MIX and MUC channels
# with the same address are intentionally operated as associated entities.
MIX_MUC_MIRROR_ENABLED=false

# ------------------------------------------------------------------------------
# Federation (S2S) Settings
# ------------------------------------------------------------------------------
FEDERATION_ENABLED=true
# Durable, bounded PostgreSQL federation queue. Stanzas are delivered at least
# once and expire after seven days if the remote domain stays unavailable.
S2S_OUTBOX_TTL_SECONDS=604800
S2S_OUTBOX_MAX_ROWS=100000
S2S_OUTBOX_MAX_BYTES=1073741824
S2S_OUTBOX_MAX_PER_DOMAIN=10000
S2S_OUTBOX_RETRY_BASE_SECONDS=5
S2S_OUTBOX_RETRY_MAX_SECONDS=3600
S2S_OUTBOX_MAX_ATTEMPTS=200
S2S_OUTBOX_CLAIM_BATCH=128
S2S_OUTBOX_LEASE_SECONDS=120
# Certificate-authenticated S2S is preferred. Dialback is a TLS-only fallback
# for legacy peers and always performs the authoritative callback from XEP-0220.
S2S_SASL_EXTERNAL_ENABLED=true
DIALBACK_ENABLED=true
# Prefer the mounted-secret form in production. A missing value creates a
# process-local random secret, which is suitable only for a single node.
# Redis cluster mode fails closed unless DIALBACK_SECRET_FILE is configured,
# because XEP-0220 verification callbacks can land on a different node.
# DIALBACK_SECRET_FILE=/run/secrets/dialback_secret
# DIALBACK_SECRET=replace-with-at-least-32-random-bytes
# Compose-only override; it otherwise derives from NORTHSTAR_SECRET_DIR.
# DIALBACK_SECRET_HOST_FILE=/etc/northstar/secrets/dialback_secret

# XEP-0484 FAST token derivation key. Production startup requires a mounted
# file containing 32-4096 random bytes; changing it revokes every FAST token.
# Direct FAST_TOKEN_SECRET environment values are accepted only by the explicit
# loopback development policy below and must never be used in production.
# FAST_TOKEN_SECRET_FILE=/run/secrets/fast_token_secret
# FAST_TOKEN_SECRET_HOST_FILE=/etc/northstar/secrets/fast_token_secret
# Development only: when true, a process-local key may be generated if Redis
# is disabled, every listener is loopback, and XMPP_DOMAIN is localhost,
# *.localhost, or *.test. Tokens then become invalid on every restart.
# FAST_TOKEN_ALLOW_EPHEMERAL_FOR_DEVELOPMENT=false
# Dummy SCRAM credentials for unknown/invalid accounts use an independent
# deployment key so enumeration-resistant work never shares the FAST token
# authority. Normal and clustered startup require a protected file containing
# 32-4096 random bytes; there is intentionally no inline environment form.
# DUMMY_SCRAM_SECRET_FILE=/run/secrets/dummy_scram_secret
# DUMMY_SCRAM_SECRET_HOST_FILE=/etc/northstar/secrets/dummy_scram_secret
# Development only: the same Redis-free, all-loopback, reserved-domain policy
# may create a separate process-local dummy key. It is never derived from FAST.
# DUMMY_SCRAM_ALLOW_EPHEMERAL_FOR_DEVELOPMENT=false
FAST_TOKEN_TTL_DAYS=30
FAST_TOKEN_ROTATION_DAYS=7
FAST_STRONG_REAUTH_MAX_DAYS=90
FEDERATION_ALLOWLIST=
FEDERATION_DENYLIST=
FEDERATION_ALLOW_PRIVATE_IPS=false
# Comma-separated domain=address overrides. Prefix an address with xmpps://
# to exercise Direct TLS; unprefixed and starttls:// addresses use STARTTLS.
FEDERATION_DNS_OVERRIDES=
# FEDERATION_EXTRA_ROOT_CERT_PATH=certs/trust/federation-ca.crt
# RFC 7712 DANE policy: off, opportunistic, or required. Opportunistic uses
# locally DNSSEC-validated PKIX-EE(1)/DANE-EE(3) when a secure XMPP SRV/TLSA
# chain exists; required forbids endpoint overrides, XEP-0487 and insecure DNS
# fallback. A secure RRset containing only usages 0/2 fails closed.
FEDERATION_DANE_MODE=off
# Optional local PEM CRL bundle for outbound serverAuth, inbound S2S
# clientAuth, and XEP-0487 HTTPS. Unknown or expired status fails closed.
# FEDERATION_CRL_PATH=certs/trust/federation.crl.pem

# ------------------------------------------------------------------------------
# Service Discovery Contact Addresses (XEP-0157)
# Comma-separated URI values, normally mailto: or xmpp: addresses.
# ------------------------------------------------------------------------------
ADMIN_ADDRESSES=
ABUSE_ADDRESSES=
SUPPORT_ADDRESSES=
FEEDBACK_ADDRESSES=
SALES_ADDRESSES=
SECURITY_ADDRESSES=

# Optional External Service Discovery (XEP-0215).
# STUN_SERVER=stun.example.com:3478
# TURN_SERVER=turn.example.com:3478
# Optional coturn `use-auth-secret` / `static-auth-secret` integration.
# Prefer the mounted-secret form in production. Set only one value or file.
# Mount this owner-only secret at the same container path with a deployment-
# specific Compose override when short-lived coturn credentials are enabled.
# TURN_SHARED_SECRET_FILE=/run/secrets/turn_shared_secret
# TURN_SHARED_SECRET=replace-with-a-long-random-secret
# TURN_CREDENTIALS_TTL_SECONDS=3600
# Per-account and per-IP sliding-window bound for on-demand TURN credentials.
# TURN_CREDENTIAL_REQUESTS_PER_MINUTE=12

# ------------------------------------------------------------------------------
# File Uploads (HTTP File Upload)
# ------------------------------------------------------------------------------
UPLOAD_DIR=data/uploads
# Storage backend: `local` is the single-node default. Public multi-node
# deployments must use `s3`; Redis does not replicate upload bytes.
UPLOAD_STORAGE_BACKEND=local
# S3-compatible example (MinIO, AWS S3, R2, and compatible services):
# UPLOAD_S3_REGION=us-east-1
# UPLOAD_S3_BUCKET=northstar-uploads
# UPLOAD_S3_PREFIX=northstar/uploads
# UPLOAD_S3_ENDPOINT=https://objects.example.com
# UPLOAD_S3_PATH_STYLE=true
# UPLOAD_S3_ALLOW_HTTP=false
# `ambient` accepts only workload identity, ECS relative credentials, or
# IMDSv2. Static AWS_* secret environment variables are rejected in production.
# `files` uses one owner-only JSON bundle so access key, secret, session token,
# and monotonically increasing generation are replaced atomically. Example:
# {"generation":2,"access_key_id":"...","secret_access_key":"...","session_token":"..."}
# UPLOAD_S3_CREDENTIAL_MODE=ambient
# UPLOAD_S3_CREDENTIAL_BUNDLE_FILE=/run/secrets/upload_s3_credentials.json
# The three-file form below is development-only and reloads require restart.
# UPLOAD_S3_ACCESS_KEY_ID_FILE=/run/secrets/upload_s3_access_key_id
# UPLOAD_S3_SECRET_ACCESS_KEY_FILE=/run/secrets/upload_s3_secret_access_key
# UPLOAD_S3_SESSION_TOKEN_FILE=/run/secrets/upload_s3_session_token
# Optional server-side KMS encryption. SSE is not end-to-end encryption.
# UPLOAD_S3_SSE_KMS_KEY_ID_FILE=/run/secrets/upload_s3_kms_key_id
UPLOAD_MAX_BYTES=26214400
# Reservations, completed objects, and expired/deleting physical projections
# consume these per-account quotas until durable cleanup completes.
UPLOAD_MAX_FILES_PER_USER=1000
UPLOAD_MAX_BYTES_PER_USER=1073741824
# GET uses a separate pool from PUT and storage reconciliation.
UPLOAD_DOWNLOAD_MAX_CONCURRENT=64
UPLOAD_DOWNLOAD_MAX_PER_IP=8
UPLOAD_DOWNLOAD_READ_TIMEOUT_SECONDS=30
UPLOAD_DOWNLOAD_MAX_SECONDS=600
# Physical retained rows and durable work, including pending deletion. New
# admissions stop before the job ceiling to reserve promotion/cleanup capacity.
UPLOAD_STORAGE_MAX_PENDING_JOBS=100000
UPLOAD_STORAGE_MAX_RETAINED_FILES=1000000
UPLOAD_STORAGE_MAX_RETAINED_BYTES=1099511627776
# Completed upload URLs expire after 30 days by default.
UPLOAD_RETENTION_SECONDS=2592000

# ------------------------------------------------------------------------------
# Anti-Abuse (Proof of Work) Settings
# ------------------------------------------------------------------------------
POW_BASE_WORK_FACTOR=1024
POW_MAX_WORK_FACTOR=524288
ABUSE_MESSAGE_FREE_BURST=60
# Calibrate POW_MAX_WORK_FACTOR on the slowest supported phone; this is the
# displayed target ceiling, not a hardware-independent timing guarantee.
POW_MAX_DEVICE_SECONDS=8
# Optional, temporary RFC 3339 UTC deadline for accepting unbound PoW v1
# challenges during a client rollout. Leave empty for the secure v2-only
# default. Remove this setting after the deadline; never use it as a permanent
# compatibility switch (example: 2026-10-01T00:00:00Z).
POW_V1_COMPATIBILITY_UNTIL=
# Required for stable production/multi-node penalties. Generate an independent
# random key; do not reuse FAST/Dialback/database secrets.
# ABUSE_STATE_HMAC_KEY_FILE=/run/secrets/abuse_state_hmac_key
# PostgreSQL stores this monotonic deployment generation and irreversible key
# IDs. Keep 1 for the first key and increment exactly once with each new current
# key; never decrement or reuse an epoch after restoring a database backup.
ABUSE_STATE_HMAC_KEY_EPOCH=1
# Rotation phase 1: set current=new, previous=old and epoch=old+1 on every node.
# New nodes keep previous=old primary for challenges/admissions until phase 2.
# ABUSE_STATE_HMAC_PREVIOUS_KEY_FILE=/run/secrets/abuse_state_hmac_previous_key
# ABUSE_STATE_HMAC_PREVIOUS_KEY_HOST_FILE=/etc/northstar/secrets/abuse_state_hmac_previous_key
# Rotation phase 2: only after every node has both keys, set this true on every
# node. The first updated node fences and shuts down old-generation processes,
# switches primary writes to current=new, and starts a minimum 30-day horizon.
# Keep both keys past retire_not_before until the documented durable-reference
# query is also zero; live offline admissions may extend the rotation. Only then
# remove previous and set false.
ABUSE_STATE_HMAC_RETIRE_PREVIOUS=false
# Development only: allows a random process-local anti-abuse key exclusively
# for a loopback, single-node localhost/*.localhost/*.test instance.
ABUSE_STATE_ALLOW_EPHEMERAL=false

# Required for stable REST idempotency and encrypted replay of login and
# invitation responses. Only the mounted-file form is accepted. Keep the old
# key mounted for at least the maximum idempotency TTL during rotation.
# API_CONTROL_SECRET_FILE=/run/secrets/api_control_secret
# API_CONTROL_PREVIOUS_SECRET_FILE=/run/secrets/api_control_previous_secret
# Development only: permits a process-local key on a loopback single-node
# localhost/*.localhost/*.test server. Replays do not survive restart.
API_CONTROL_ALLOW_EPHEMERAL=true
ABUSE_WINDOW_SECONDS=60
ABUSE_COOLDOWN_SECONDS=60
ABUSE_MAX_WAIT_SECONDS=900

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_DIR=logs
LOG_ROTATION=daily
LOG_FORMAT=text
LOG_RETENTION_FILES=30
RUST_LOG=info

# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
# BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password
# XEP-0133 restart/shutdown commands require an explicit opt-in and a
# confirmation form. Leave disabled unless a service supervisor is configured.
ENABLE_XMPP_SERVICE_CONTROL=false
# A connected account is reported idle after this many seconds without an
# accepted client stanza. Cluster heartbeats publish this state every 30s.
ADMIN_IDLE_SECONDS=900
# BOOTSTRAP_ADMIN_PASSWORD_SECRET_FILE=/etc/northstar/secrets/bootstrap_admin_password
# GRAFANA_ADMIN_PASSWORD_SECRET_FILE=/etc/northstar/secrets/grafana_admin_password
PROMETHEUS_RETENTION=30d
