{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.invalid/schemas/catalog-crates.schema.json",
  "title": "Northstar Crate Policy Catalog",
  "type": "object",
  "required": ["version", "crates"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "crates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["crate_id", "package", "path", "layer", "owner_team", "api_stability", "publish_policy", "allowed_dependencies"],
        "properties": {
          "crate_id": { "type": "string", "minLength": 1 },
          "package": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "layer": { "enum": ["foundation", "domain", "application", "xep", "adapter", "service", "tooling", "support"] },
          "owner_team": { "type": "string", "minLength": 1 },
          "api_stability": { "type": "string", "minLength": 1 },
          "publish_policy": { "const": "never" },
          "allowed_dependencies": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
