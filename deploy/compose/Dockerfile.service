# Multi-stage Dockerfile for Northstar Microservices
# Defined per northstar_microservices_deep_audit_2026-09-03.md (Section 16).

FROM rust:1.80-alpine AS builder

RUN apk add --no-cache musl-dev protobuf-dev

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY services ./services
COPY catalog ./catalog
COPY contracts ./contracts

ARG SERVICE_NAME
RUN cargo build --release -p ${SERVICE_NAME}

FROM alpine:3.20 AS runner
RUN apk add --no-cache ca-certificates

ARG SERVICE_NAME
WORKDIR /app
COPY --from=builder /app/target/release/${SERVICE_NAME} /app/service

USER 10001:10001
ENTRYPOINT ["/app/service"]
