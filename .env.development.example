# Northstar localhost development profile
#
# Copy this file to `.env`, replace both PostgreSQL URL placeholders, generate
# the development certificate, run migrations, and start the foreground server.
# This profile is intentionally rejected outside a single-process, Redis-free,
# reserved-domain deployment whose every listener is loopback.
#
# NEVER use this file as a production configuration. Production requires
# independent runtime, migrator and ADMIN_COMMAND database identities plus
# stable mounted secret files. See `.env.example` and docs/PRODUCTION_OPERATIONS.md.

XMPP_DOMAIN=localhost
SERVER_NAME=Northstar Development
PUBLIC_URL=http://127.0.0.1:8080
NORTHSTAR_VERSION=0.2.0
NORTHSTAR_VCS_REF=unknown

# Bind every possible listener to loopback so none is reachable from the LAN.
XMPP_BIND=127.0.0.1:5222
XMPPS_BIND=127.0.0.1:5223
S2S_BIND=127.0.0.1:5269
S2S_TLS_BIND=127.0.0.1:5270
HTTP_BIND=127.0.0.1:8080
METRICS_BIND=127.0.0.1:9091
COMPONENT_BIND=127.0.0.1:5347
COMPONENTS_ENABLED=false
BOSH_ENABLED=false

TLS_CERT_PATH=certs/server.crt
TLS_KEY_PATH=certs/server.key

# Replace both placeholders with the same local PostgreSQL owner URL only for
# this development profile. The host must remain loopback.
DATABASE_URL=postgres://northstar_dev:replace-with-a-local-password@127.0.0.1/northstar_dev
MIGRATOR_DATABASE_URL=postgres://northstar_dev:replace-with-a-local-password@127.0.0.1/northstar_dev
DATABASE_ALLOW_UNSAFE_ROLE_FOR_DEVELOPMENT=true
MIGRATOR_ALLOW_UNSAFE_ROLE_FOR_DEVELOPMENT=true

# ADMIN_COMMAND_DATABASE_URL is deliberately omitted here. The explicit
# development flag above permits reuse of DATABASE_URL on localhost. Production
# must configure an independent ADMIN_COMMAND_DATABASE_URL_FILE (preferred) or
# ADMIN_COMMAND_DATABASE_URL for the restricted command identity.

# Each switch independently authorizes a fresh process-local key. These values
# are not persisted and all associated tokens/replay identities may be invalid
# after restart. Stable production deployments must mount separate key files.
FAST_TOKEN_ALLOW_EPHEMERAL_FOR_DEVELOPMENT=true
DUMMY_SCRAM_ALLOW_EPHEMERAL_FOR_DEVELOPMENT=true
ABUSE_STATE_ALLOW_EPHEMERAL=true
API_CONTROL_ALLOW_EPHEMERAL=true

# Keep experimental distributed and legacy federation paths out of this local
# quick start. No REDIS_URL is configured.
DIALBACK_ENABLED=false
FEDERATION_ALLOW_PRIVATE_IPS=false

OPEN_REGISTRATION=true
# Set true to require a valid invitation token on every Web/REST/XEP-0077
# registration. OPEN_REGISTRATION=false disables public registration entirely.
INVITATION_REQUIRED=false
REQUIRE_ENCRYPTED_ARCHIVE=true
LOG_DIR=logs
LOG_FORMAT=text
RUST_LOG=info

# Optional first local administrator. Set both together and replace the sample
# password before first start, or leave both unset and register normally.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-local-password
